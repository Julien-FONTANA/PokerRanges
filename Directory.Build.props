<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Symbols live inside the assembly rather than in a .pdb alongside it: a stack trace keeps
         its line numbers, and publishing has nothing to drag along. The setting used to be carried
         by the publish profile alone, and therefore by the application alone; Core and Data were
         still dropping their .pdb files into the published folder. -->
    <DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>Personnel</Company>
    <Product>PokerRanges</Product>
    <Description>Texas Hold'em No Limit tournament decision assistant.</Description>
    <Version>1.1.0</Version>
  </PropertyGroup>

</Project>
