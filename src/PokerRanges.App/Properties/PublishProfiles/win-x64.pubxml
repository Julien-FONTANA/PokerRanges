<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication autonome : un seul PokerRanges.exe, sans .NET installé sur la machine.

  Le rognage (PublishTrimmed) est volontairement désactivé. Deux parties de l'application lisent
  des types par réflexion et le rognage les supprimerait sans prévenir : la sérialisation JSON des
  réglages, de la main en cours et du journal, et le chargement XAML d'Avalonia. Le fichier serait
  deux fois plus petit et planterait à la première sauvegarde.

  La compression est en revanche activée : elle divise la taille par deux environ, au prix de
  quelques dixièmes de seconde au premier lancement, ce qui est le bon échange pour un exécutable
  qu'on recopie d'une machine à l'autre.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Les symboles vivent dans l'assembly : une pile d'appel garde ses numéros de ligne, et il
         n'y a toujours qu'un fichier à copier. -->
    <DebugType>embedded</DebugType>

    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
