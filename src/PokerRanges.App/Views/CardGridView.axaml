<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PokerRanges.App.ViewModels"
             x:Class="PokerRanges.App.Views.CardGridView"
             x:DataType="vm:CardPickerViewModel">

  <ItemsControl ItemsSource="{Binding Cards}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Rows="4" Columns="13" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:CardOptionViewModel">
        <Button Classes="card"
                Classes.picked="{Binding IsSelected}"
                IsEnabled="{Binding IsAvailable}"
                Command="{Binding $parent[ItemsControl].((vm:CardPickerViewModel)DataContext).ToggleCommand}"
                CommandParameter="{Binding}">
          <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="12" />
        </Button>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>

</UserControl>
